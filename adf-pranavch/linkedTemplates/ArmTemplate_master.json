{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-pranavch"
		},
		"ABSLake_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ABSLake'"
		},
		"lsadgen2pranav_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'lsadgen2pranav'"
		},
		"lsadlsgen2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'lsadlsgen2'"
		},
		"lsadslsgentwo_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'lsadslsgentwo'"
		},
		"lstoasqldb_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'lstoasqldb'"
		},
		"lsadgen2pranav_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sapranav.dfs.core.windows.net/"
		},
		"lsadlsgen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sapranav.dfs.core.windows.net/"
		},
		"lsadslsgentwo_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sapranav.dfs.core.windows.net/"
		},
		"lstoasqldb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dbserverpranav.database.windows.net"
		},
		"lstoasqldb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dbsqlpranav"
		},
		"lstoasqldb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "pranavadmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-pranavch_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ABSLake_connectionString": {
						"value": "[parameters('ABSLake_connectionString')]"
					},
					"lsadgen2pranav_accountKey": {
						"value": "[parameters('lsadgen2pranav_accountKey')]"
					},
					"lsadlsgen2_accountKey": {
						"value": "[parameters('lsadlsgen2_accountKey')]"
					},
					"lsadslsgentwo_accountKey": {
						"value": "[parameters('lsadslsgentwo_accountKey')]"
					},
					"lstoasqldb_password": {
						"value": "[parameters('lstoasqldb_password')]"
					},
					"lsadgen2pranav_properties_typeProperties_url": {
						"value": "[parameters('lsadgen2pranav_properties_typeProperties_url')]"
					},
					"lsadlsgen2_properties_typeProperties_url": {
						"value": "[parameters('lsadlsgen2_properties_typeProperties_url')]"
					},
					"lsadslsgentwo_properties_typeProperties_url": {
						"value": "[parameters('lsadslsgentwo_properties_typeProperties_url')]"
					},
					"lstoasqldb_properties_typeProperties_server": {
						"value": "[parameters('lstoasqldb_properties_typeProperties_server')]"
					},
					"lstoasqldb_properties_typeProperties_database": {
						"value": "[parameters('lstoasqldb_properties_typeProperties_database')]"
					},
					"lstoasqldb_properties_typeProperties_userName": {
						"value": "[parameters('lstoasqldb_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}